# Indexer API base. In dev the default /api is proxied to http://localhost:8787 (set INDEXER_URL to change).
VITE_API_URL=/api
# Solana RPC used by the browser for transactions and on-chain checks. Use a key-restricted endpoint in production.
VITE_RPC_URL=https://api.devnet.solana.com
VITE_CLUSTER=devnet
